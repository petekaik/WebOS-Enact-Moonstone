{
	"name": "hello-moonstone",
	"version": "1.0.0",
	"description": "A first take on Enact Moonstone application.",
	"author": "",
	"main": "src/index.js",
	"scripts": {
		"serve": "enact serve",
		"pack": "enact pack",
		"pack-p": "enact pack -p",
		"watch": "enact pack --watch",
		"clean": "enact clean",
		"lint": "enact lint .",
		"license": "enact license",
		"test": "enact test",
		"test-watch": "enact test --watch",
		"build-ipk": "mkdir -p dist/build && enact pack -p && ares-package ./dist -o ./dist/build",
		"install-ipk": "ares-install ./dist/build/*.ipk",
		"launch-app": "ares-launch hello-moonstone",
		"deploy": "npm run build-ipk && npm run install-ipk && npm run launch-app"
	},
	"license": "UNLICENSED",
	"private": true,
	"repository": "",
	"enact": {
		"theme": "moonstone"
	},
	"eslintConfig": {
		"extends": "enact-proxy"
	},
	"eslintIgnore": [
		"node_modules/*",
		"build/*",
		"dist/*"
	],
	"dependencies": {
		"@enact/core": "^1.13.4",
		"@enact/i18n": "^1.13.4",
		"@enact/moonstone": "^1.13.4",
		"@enact/spotlight": "^1.13.4",
		"@enact/ui": "^1.13.4",
		"classnames": "^2.2.6",
		"core-js": "^3.6.5",
		"eases": "^1.0.8",
		"ilib": "^14.1.0",
		"invariant": "^2.2.4",
		"prop-types": "^15.7.2",
		"ramda": "^0.27.0",
		"react": "^15.6.2",
		"react-dom": "^15.6.2",
		"recompose": "^0.26.0",
		"warning": "^4.0.3",
		"web-vitals": "^1.0.1",
		"xhr": "^2.6.0"
	},
	"devDependencies": {
		"@babel/core": "^7.27.1",
		"@babel/plugin-proposal-class-properties": "^7.18.6",
		"@babel/plugin-proposal-object-rest-spread": "^7.20.7",
		"@babel/preset-env": "^7.27.1",
		"@babel/preset-react": "^7.27.1",
		"@enact/cli": "^6.1.4",
		"babel-eslint": "^10.1.0",
		"eslint": "^9.25.1",
		"eslint-config-enact": "^4.2.1",
		"eslint-plugin-enact": "^1.0.8",
		"eslint-plugin-react": "^7.37.5",
		"webpack": "^5.99.7",
		"webpack-cli": "^6.0.1",
		"webpack-dev-server": "^5.2.1"
	},
	"volta": {
		"node": "16.20.2"
	}
}
